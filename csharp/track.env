# Track settings, read by check-setup (and the authoring repo's tools).
TRACK=csharp
TEST_COMMAND="dotnet test"
SEED_EXPECT="Failed: +1, Passed: +2"
VSCODE_EXTENSION=ms-dotnettools.csdevkit
# Runs only the tests for TODO {n} (used by the authoring repo's checkpoint verifier).
TODO_TEST="run-tests --filter Todo{n}"
