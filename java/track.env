# Track settings, read by check-setup (and the authoring repo's tools).
TRACK=java
TEST_COMMAND="mvn -q -o test"
SEED_EXPECT="Tests run: 3, Failures: 1, Errors: 0"
VSCODE_EXTENSION=vscjava.vscode-java-pack
# Runs only the tests for TODO {n} (used by the authoring repo's checkpoint verifier).
TODO_TEST="run-tests -Dtest=*#todo{n}*"
