#!/bin/sh
# Puts /workspace back, from inside the container. Your app code and your run
# logs are not touched.
#   reset-workspace           the calculator project, as at the start
#   reset-workspace --empty   an empty project (a git repo with no files), for your own tasks
set -eu
case "${1:-}" in
  "") empty="" ;;
  --empty) empty="yes" ;;
  *) echo "Usage: reset-workspace [--empty]" >&2; exit 2 ;;
esac

# Files you made yourself (not via in-workspace) are yours, and runner may not delete them.
find /workspace -mindepth 1 -user "$(id -un)" -delete 2>/dev/null || true

if [ -n "$empty" ]; then
  # A fresh repo, not an empty folder: the seed service refills an empty /workspace.
  refill='git init -q -b main && git -c user.name="Workshop Seed" -c user.email=seed@workshop.invalid commit -q --allow-empty -m empty'
else
  refill='/usr/local/bin/seed-workspace >/dev/null'
fi
# Everything else as runner, like the agent's commands: delete, then refill.
sudo -u runner timeout 120 sh -c "cd /workspace && find . -mindepth 1 -delete && $refill"

if [ -n "$empty" ]; then
  echo "Workspace emptied: /workspace is an empty git repo. Give the agent a task of your own, e.g. run-agent my-task.md (see the cheat sheet)"
else
  echo "Workspace reset: the calculator project is back to its seed state."
fi
case "$PWD/" in
  /workspace/?*) echo "(Your shell was in a folder that is gone now: cd /workspace)" ;;
esac
